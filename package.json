{
  "name": "cat-trail",
  "version": "0.1.0",
  "private": true,
  "description": "猫踪 CatTrail —— 你的每一次骑行，都是这座城市里猫的踪迹（iGPSPORT 同步 / FIT 上传 / 夜巡黑猫地图主题）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync": "node --env-file-if-exists=.env --import tsx apps/server/src/run-sync.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
